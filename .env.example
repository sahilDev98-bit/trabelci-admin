# Production

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Dev-only: Vite proxy target for `/api/*` requests.
# This should point at the running `trabelci-admin-main` server.


# VITE_ADMIN_API_BASE_URL=
VITE_ADMIN_API_BASE_URL=

# Room Visualizer (Generate AI Images) — left unset on purpose. AiImagesPage.tsx
# already falls back to the right URL for each context on its own (local
# server.py in dev, the live /room-visualizer proxy in a production build) —
# setting it here would apply to both `npm run dev` and the Docker build
# alike, which is exactly the local-dev-calls-the-live-API bug this replaced.
# Only set this to override that per-environment default (e.g. a staging URL).
# VITE_ROOM_VISUALIZER_URL=

# Extract Product from PDF — same story as VITE_ROOM_VISUALIZER_URL above,
# left unset on purpose. ExtractProductPdfPage.tsx falls back to
# http://localhost:5058 in dev and the live /extract-product-pdf proxy in a
# production build.
# VITE_EXTRACT_PDF_URL=

