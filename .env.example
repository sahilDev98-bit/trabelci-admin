VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"


# Optional: if you want the SPA to call a different origin directly instead of relying on the dev proxy.
# Leave empty to use relative `/api/*` paths.
# VITE_ADMIN_API_BASE_URL="https://admin-backend.example.com"

# Room Visualizer (Generate AI Images) — leave unset. AiImagesPage.tsx
# already picks the right default per build: http://localhost:5057 for
# `npm run dev`, and trabelci-api-main's own domain + /room-visualizer (that
# path is proxied internally to the Room Visualizer's own port — see
# index.js) for a production build. Only set this to override that, e.g. a
# staging environment's URL.
# VITE_ROOM_VISUALIZER_URL=